#!/usr/bin/env bash
set -euo pipefail

FLAKE=".#rhroot"
LOG_FILE="$HOME/.cache/nixos-switch.log"
HOST_NAME="${FLAKE#*.#}"
mkdir -p "$HOME/.cache"
cd ~/env/nixos/ || exit 1

# Colors
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
MAGENTA="\033[1;35m"
DIM="\033[2m"
BOLD="\033[1m"
RESET="\033[0m"

printf "\n%b\n" "${BOLD}${MAGENTA}NixOS Upgrade${RESET}"
printf "%b\n" "${DIM}──────────────────────────────${RESET}"
printf "%b\n" "${DIM}target ${RESET}nixosConfigurations.${HOST_NAME}"
printf "%b\n\n" "${DIM}log    ${RESET}${LOG_FILE}"

printf "%b\n" "${YELLOW}󰚰 Updating flake inputs${RESET}"
nix flake update

printf "%b\n" "${YELLOW}󰐍 Rebuilding system${RESET}"

set +e
sudo nixos-rebuild switch --impure --flake "$FLAKE" 2>&1 | tee "$LOG_FILE" | awk '
  /building the system configuration/ { print "\n\033[1;33m󰐍  Building system\033[0m"; next }
  /activating the configuration/ { print "\n\033[1;34m󰑓  Activating configuration\033[0m"; next }
  /restarting|starting|stopping/ { print "  \033[1;36m→ " $0 "\033[0m"; next }
  /copying path|substituting/ { next }
  /downloading/ { print "  \033[2m" $0 "\033[0m"; next }
  /warning/ { print "\033[1;33m⚠ " $0 "\033[0m"; next }
  /error:/ { print "\033[1;31m✖ " $0 "\033[0m"; next }
  { print } # Print everything else
'
REBUILD_STATUS=${PIPESTATUS[0]}
set -e

if [ "$REBUILD_STATUS" -eq 0 ]; then
  printf "\n%b\n" "${GREEN}✔ Rebuild successful${RESET}"

  if ! git diff --quiet; then
    git add .
    git commit -m "chore(flake): update lockfile $(date +%F)"
    printf "%b\n" "${CYAN}  → committed changes${RESET}"
  else
    printf "%b\n" "${DIM}  → no lockfile changes${RESET}"
  fi

  printf "\n%b\n" "${DIM}──────────────────────────────${RESET}"
  printf "%b\n" "${GREEN}Upgrade complete${RESET}"
else
  printf "\n%b\n\n" "${RED}✖ Rebuild failed (Git commit skipped)${RESET}"
  grep -iE "error:|failed" "$LOG_FILE" | tail -n 20 || true
  exit 1
fi
