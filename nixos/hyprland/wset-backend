#!/bin/sh

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <path_to_image"
  exit 1
fi

IMAGE="$1"
CACHE_FILE="$HOME/.cache/hyprpaper/last_wallpaper.txt"

notify-send "Changing Theme" "Applying new wallpaper and updating colors, please wait until confirmation..."

# === Save the wallpaper path for restoration ===
echo "$IMAGE" >"$CACHE_FILE"
# Get monitor name (primary or first monitor)
MONITOR=$(hyprctl monitors -j | jq -r '.[0].name')
# First, preload the image
hyprctl hyprpaper preload "$IMAGE"
# Then set it on your monitor
hyprctl hyprpaper wallpaper "$MONITOR, $IMAGE"

# Take colors from Image
matugen image "$IMAGE" -m dark -t scheme-content --source-color-index 0

# Reload
hyprctl reload
kill -10 $(pgrep kitty) 2>/dev/null

notify-send "Theme Applied" "Wallpaper and Theme updated successfully"
