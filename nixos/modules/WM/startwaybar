#!/bin/sh

PIDFILE="/tmp/waybar_watchdog.pid"
LOCKFILE="/tmp/waybar_watchdog.lock"

exec 200>"$LOCKFILE"
if ! flock -n 200; then
  echo "ERROR: Waybar watchdog is already running"
  exit 1
fi
echo $$ >"$PIDFILE"
cleanup() {
  rm -f "$PIDFILE"
  flock -u 200
  exit 0
}
trap cleanup INT TERM EXIT
echo "Starting waybar watchdog (PID: $$)"
killall waybar 2>/dev/null
sleep 1
while true; do
  waybar
  echo "Waybar exited, restarting in 2 seconds..."
  sleep 2
done
