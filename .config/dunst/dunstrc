[global]
monitor = 0
follow = mouse
width = 400
origin = top-right
offset = 30x40
shrink = yes
notification_limit = 5
progress_bar = true
font = JetBrainsMono Nerd Font 14
markup = full
padding = 12
horizontal_padding = 14
frame_width = 2
corner_radius = 10
frame_color = "#3e4451"
separator_height = 1
separator_color = frame
alignment = left
transparency = 5
icon_position = left
max_icon_size = 56
enable_recursive_icon_lookup = true
icon_path = /usr/share/icons:/usr/local/share/icons:/home/sten/.local/share/icons
icon_theme = Papirus-Dark
history_length = 50
sticky_history = yes
show_indicators = yes
sort = yes
stack_duplicates = true
hide_duplicate_count = no
indicate_hidden = yes
idle_threshold = 0
show_age_threshold = 60
word_wrap = yes
ellipsize = middle
format = "<b>%s</b>\n%a\n%b"
browser = xdg-open 
mouse_left_click = open_url    
mouse_middle_click = do_action 
mouse_right_click = close_current

[urgency_low]
background = "#282c34"
foreground = "#abb2bf"
frame_color = "#3e4451"
timeout = 4
fullscreen = delay

[urgency_normal]
background = "#282c34"
foreground = "#abb2bf"
frame_color = "#61afef"
timeout = 7
fullscreen = delay

[urgency_critical]
background = "#282c34"
foreground = "#e06c75"
frame_color = "#e06c75"
timeout = 0
fullscreen = show

[volume]
appname = "pulseaudio|pipewire|volume"
timeout = 2
urgency = low

[screenshot]
summary = "Screenshot saved"
timeout = 2
urgency = low
