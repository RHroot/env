#!/bin/sh

export DISPLAY=:0

xset -dpms s off
xset r rate 200 40
if ! xrandr --query | grep -q "1920x1080.*\*"; then
  xrandr --output eDP-1 --mode "1920x1080" --rate 60.00 2>/dev/null
fi

# Start/restart services safely
for service in picom dunst flameshot nm-applet libinput-gestures; do
  if ! pgrep -f "$service" >/dev/null; then
    $service &
  fi
done

# Handle copyq specially
if ! pgrep -f copyq >/dev/null; then
  copyq --start-server &
fi

# Start polkit if not running
if ! pgrep -f polkit-gnome-authentication-agent-1 >/dev/null; then
  systemctl --user start polkit-gnome-authentication-agent-1
fi

if [ -f "$HOME/.fehbg" ]; then
  sh -c "$HOME/.fehbg"
fi
