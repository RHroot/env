#!/usr/bin/env zsh

# --- Git ---
ga() {
  git add .
}
gs() {
  git status
}
gp() {
  git push
}
gc() {
  if [ -z "$*" ]; then
    git commit -m "automated dev commit"
  else
    git commit -m "$*"
  fi
}
gac() {
  git add .
  if [ -z "$*" ]; then
    git commit -m "automated dev commit"
  else
    git commit -m "$*"
  fi
}
gacp() {
  git add .
  if [ -z "$*" ]; then
    git commit -m "automated dev commit"
  else
    git commit -m "$*"
  fi
  git push
}

nix-zsh() {
  nix-shell "$@" --command zsh
}

(( $+commands[batman])) && alias man="batman"

if (( $+commands[bat] )); then
  export PAGER="bat"
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  alias less="bat"
  alias bat="bat --paging=always"
else
  export PAGER="less"
  export LESS="-R -M -i -w -F --use-color"
  export MANPAGER="less"
  less() {
    command less $LESS "$@"
  }
fi
export PAGER MANPAGER

nix-clean() {
  emulate -L zsh
  setopt localoptions pipefail
  local keep_generations=${1:-5}
  local aggressive=0
  local dry_run=0
  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --aggressive) aggressive=1; shift ;;
      --dry-run|-n) dry_run=1; shift ;;
      --keep|-k) keep_generations=${2:-5}; shift 2 ;;
      *) break ;;
    esac
  done
  if [[ $dry_run -eq 1 ]]; then
    echo "🔍 Dry-run mode: no changes will be made."
  fi
  # Helper to optionally echo "sudo" and commands
  maybe_sudo() {
    if [[ $dry_run -eq 0 ]]; then
      if [[ $1 == -- ]]; then shift; fi
      "$@"
    else
      echo "[DRY-RUN] $*"
    fi
  }
  echo "🧹 Starting Nix cleanup (keeping last $keep_generations system/user generations)..."
  # --- System generations (NixOS) ---
  echo "🗑️  System generations:"
  if [[ $dry_run -eq 0 ]]; then
    sudo nix-env -p /nix/var/nix/profiles/system --list-generations 2>/dev/null | tail -n +$(($keep_generations + 1)) | wc -l | xargs -I{} echo "   {} old generations to delete"
  fi
  maybe_sudo sudo nix-env -p /nix/var/nix/profiles/system --delete-generations "+$keep_generations"
  # --- User generations ---
  echo "🗑️  User generations:"
  if [[ $dry_run -eq 0 ]]; then
    nix-env --list-generations 2>/dev/null | tail -n +$(($keep_generations + 1)) | wc -l | xargs -I{} echo "   {} old generations to delete"
  fi
  maybe_sudo nix-env --delete-generations "+$keep_generations"
  # --- Garbage collection ---
  echo "🗑️  Collecting garbage..."
  maybe_sudo sudo nix-collect-garbage -d
  # --- Optional: clean tmp gcroots (safe and Nix-native) ---
  echo "🧹 Cleaning temporary GC roots..."
  if [[ $dry_run -eq 0 ]]; then
    # Only delete broken symlinks in Nix's tmp gcroots
    local tmp_gcroot="/nix/var/nix/gcroots/tmp"
    if [[ -d "$tmp_gcroot" ]]; then
      local broken_count
      broken_count=$(find "$tmp_gcroot" -type l ! -exec test -e {} \; -print | wc -l)
      echo "   Found $broken_count broken temporary GC roots"
      if [[ $dry_run -eq 0 ]]; then
        find "$tmp_gcroot" -type l ! -exec test -e {} \; -delete 2>/dev/null
      fi
    fi
  else
    echo "[DRY-RUN] find /nix/var/nix/gcroots/tmp -type l ! -exec test -e {} \; -delete"
  fi
  # --- Aggressive cleanup (optional) ---
  if [[ $aggressive -eq 1 ]]; then
    echo "🧨 Aggressive mode: deleting old boot profiles and channel caches..."
    if [[ $dry_run -eq 0 ]]; then
      # Remove old NixOS boot entries (>= 10 days old)
      sudo find /nix/var/nix/profiles -maxdepth 1 -name 'system-*-link' -type d -mtime +10 -exec rm -f {} \; 2>/dev/null
      # Clear channel caches (safe to re-download)
      rm -rf ~/.cache/nix/channels 2>/dev/null
    else
      echo "[DRY-RUN] sudo find /nix/var/nix/profiles -name 'system-*-link' -mtime +10 -delete"
      echo "[DRY-RUN] rm -rf ~/.cache/nix/channels"
    fi
  fi
  # --- Optimize deduplication ---
  echo "💎 Optimizing store (deduping)..."
  maybe_sudo sudo nix-store --optimise
  # --- Final stats ---
  if [[ $dry_run -eq 0 ]]; then
    local sys_size=$(du -sh /nix/store 2>/dev/null | cut -f1)
    echo "✅ Cleanup complete. /nix/store size: $sys_size"
    echo "   Generations kept: $keep_generations (system & user)"
  else
    echo "✅ Dry-run complete."
  fi
}

git-clean() {
  emulate -L zsh
  setopt extendedglob

  # Colors
  local RED=$'\e[31m'
  local GREEN=$'\e[32m'
  local YELLOW=$'\e[33m'
  local BLUE=$'\e[34m'
  local RESET=$'\e[0m'

  # Check if inside a Git repo
  if [[ ! -d .git ]]; then
    echo "${RED}❌ Not inside a Git repository.${RESET}"
    return 1
  fi

  if (($# > 0)); then
    case $1 in
      --hard)
        echo "${YELLOW}⚠️  HARD CLEANUP: This rewrites history and may break shared repos.${RESET}"
        echo "   Backup first! Press Ctrl+C to abort."

        # Safety checks
        local dirty untracked unpushed
        dirty=$(git diff --quiet || echo "dirty")
        untracked=$(git ls-files --others --exclude-standard)
        unpushed=$(git log --branches --not --remotes --oneline)

        if [[ -n $dirty ]]; then
          echo "${RED}❌ You have uncommitted changes. Commit or stash them first.${RESET}"
          return 1
        fi

        if [[ -n $untracked ]]; then
          echo "${RED}❌ You have untracked files:${RESET}"
          echo "$untracked"
          return 1
        fi

        if [[ -n $unpushed ]]; then
          echo "${RED}❌ You have commits not pushed to any remote:${RESET}"
          echo "$unpushed" | less -S
          return 1
        fi

        read "confirm?Continue with hard cleanup? (y/N) "
        if [[ ! $confirm =~ ^[Yy]$ ]]; then
          echo "${RED}❎ Aborted hard cleanup.${RESET}"
          return 0
        fi

        # Check for large files
        local large_files
        large_files=$(git rev-list --objects --all |
          git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' |
          awk '$1 == "blob" && $3 > 10485760 {printf "%.2f MB\t%s\n", $3/1048576, $4}')

        if [[ -n $large_files ]]; then
          echo "${RED}🚨 Large files found in history:${RESET}"
          echo "$large_files" | less -S
        else
          echo "${GREEN}✅ No blobs larger than 10MB found.${RESET}"
        fi

        # Perform cleanup if tools are available
        if command -v git-filter-repo >/dev/null 2>&1; then
          git filter-repo --strip-blobs-bigger-than 10M --force
          echo "${GREEN}✅ git-filter-repo cleanup complete.${RESET}"
        elif command -v bfg >/dev/null 2>&1; then
          bfg --strip-blobs-bigger-than 10M
          git reflog expire --expire=now --all
          git gc --prune=now --aggressive
          echo "${GREEN}✅ BFG cleanup complete.${RESET}"
        else
          echo "${RED}❌ Neither git-filter-repo nor BFG installed. Cannot do hard cleanup.${RESET}"
        fi
        ;;
      *)
        echo "${RED}Unknown option: $1${RESET}"
        echo "Usage: git-clean [--hard]"
        return 1
        ;;
    esac
  else
    echo "${BLUE}🧹 Performing safe cleanup...${RESET}"
    git reflog expire --expire=now --all
    git gc --prune=now --aggressive
    echo "${GREEN}✅ Safe cleanup complete!${RESET}"
  fi
}

cn() {
  cd ~/.config/nvim
  nvim
  cd -
}

view() {
  if command -v bat >/dev/null 2>&1; then
    command bat --paging=always "$@"
  else
    cat "$@"
  fi
}

run() {
  if [[ ! -f "$1" ]]; then
    echo "Error: File '$1' not found"
    return 1
  fi
  local file="$1"
  local original_perms=$(stat -c %a "$file" 2>/dev/null)
  if [[ -z "$original_perms" ]]; then
    echo "Error: Could not read permissions"
    return 1
  fi
  chmod +x "$file" || {
    echo "Error: Could not make executable"
    return 1
  }
  ./"$@"
  local exit_code=$?
  chmod "$original_perms" "$file"
  return $exit_code
}

netcheck() {
  echo "===== NETWORK DIAGNOSTICS ====="

  echo
  echo "[1] IPv6 Status:"
  if [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" == "1" ]] || \
     grep -q "ipv6.disable=1" /proc/cmdline; then
    echo "  IPv6: DISABLED"
  else
    echo "  IPv6: ENABLED (WARNING)"
  fi

  echo
  echo "[2] IPv4 Connectivity:"
  if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then
    echo "  IPv4: OK (1.1.1.1 reachable)"
  else
    echo "  IPv4: FAIL (cannot reach 1.1.1.1)"
  fi

  echo
  echo "[3] Active DNS Servers (/etc/resolv.conf):"
  grep "^nameserver" /etc/resolv.conf | awk '{print "  "$2}'

  echo
  echo "[4] DNS Resolution (example.com):"
  DNS_ANSWER=$(dig +short example.com @$(grep "^nameserver" /etc/resolv.conf | head -n1 | awk '{print $2}') 2>/dev/null)
  if [[ -n "$DNS_ANSWER" ]]; then
    echo "  DNS OK → $DNS_ANSWER"
  else
    echo "  DNS FAIL"
  fi

  echo
  echo "[5] Internet Connectivity:"
  if ping -c1 -W3 example.com >/dev/null 2>&1; then
    echo "  Internet: OK (example.com reachable)"
  else
    echo "  Internet: FAIL (example.com unreachable)"
  fi

  echo
  echo "===== CHECK COMPLETE ====="
}

wgcheck() {
  echo "===== WIREGUARD STATUS ====="

  if ! command -v wg >/dev/null 2>&1; then
    echo "wg command not found (wireguard-tools not installed?)"
    return 1
  fi

  if ! ip link show wg0 >/dev/null 2>&1; then
    echo "wg0: interface DOWN or not present"
    return 1
  fi

  local out
  out=$(sudo wg show wg0 2>/dev/null)

  echo
  echo "[1] Interface + Peer:"
  echo "$out"

  echo
  echo "[2] Default routes:"
  ip route | grep "^default" || echo "  (no default routes?)"

  echo
  echo "[3] Public IP via tunnel:"
  curl -s ifconfig.me && echo

  echo
  echo "===== WG CHECK COMPLETE ====="
}

hyprctl_fixed() {
  local d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
  [ -d "$d" ] || { printf 'no hypr socket dir: %s\n' "$d" >&2; return 1; }

  # collect ss once (if ss absent, ssout will be empty)
  local ssout
  ssout=$(ss -xlp 2>/dev/null || true)

  # if an existing signature is set and its socket is listening, use it
  if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    local cand="${d}/${HYPRLAND_INSTANCE_SIGNATURE}/.socket.sock"
    case "$ssout" in
      *"$cand"*)
        /run/current-system/sw/bin/hyprctl "$@"
        return $?
        ;;
    esac
  fi

  # prefer an instance directory that has a listening .socket.sock
  local dir path bn found
  for dir in "$d"/*(/); do            # zsh: only directories
    path="${dir%/}/.socket.sock"
    case "$ssout" in
      *"$path"*)
        bn=${dir##*/}                # zsh param expansion -> basename
        export HYPRLAND_INSTANCE_SIGNATURE="$bn"
        found=1
        break
        ;;
    esac
  done

  # fallback: pick newest directory (zsh glob qualifiers sort by mtime)
  if [ -z "$found" ]; then
    setopt localoptions nullglob
    local arr=( "$d"/*(/om) )       # /o = sort, /m = mtime (newest first)
    if (( ${#arr[@]} )); then
      export HYPRLAND_INSTANCE_SIGNATURE=${arr[1]##*/}
    fi
  fi

  /run/current-system/sw/bin/hyprctl "$@"
}
alias hyprctl='hyprctl_fixed'
