;; ─── Variables & Polls ─────────────────────────────────────
(defpoll poll-clock :interval "1s" "date '+%I:%M %p  •  %a %b %d, %Y'")
(defpoll poll-workspaces :interval "0.2s" "sh ~/.config/eww/get-workspaces.sh")
(defpoll poll-battery-cap :interval "5s" "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo '0'")
(defpoll poll-battery-stat :interval "5s" "cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo 'Unknown'")
(defpoll poll-audio-vol :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}' || echo '0'")
(defpoll poll-audio-mute :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo muted || echo unmuted")
(defpoll poll-brightness :interval "2s" "brightnessctl g | xargs -I{} sh -c 'max=$(brightnessctl m); echo $(( {} * 100 / max ))' || echo '0'")
(defpoll poll-user :interval "1h" "whoami")
(defpoll poll-nightlight :interval "1s" "sh ~/.config/eww/nightlight.sh status")

;; Hardware Polls
(defpoll poll-cpu-usage :interval "2s" "top -bn1 | grep 'Cpu(s)' | awk '{print $2}' | cut -d'.' -f1 || echo '0'")
(defpoll poll-cpu-freq :interval "2s" "awk '{sum += $1} END {if (NR > 0) printf \"%.1fGHz\", sum / NR / 1000000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null || echo '0GHz'")
(defpoll poll-ram :interval "3s" "free -h | awk '/Mem:/ {print $3 \"/\" $2}' | tr -d 'i' || echo '0G'")
(defpoll poll-disk :interval "10s" "df -h / | awk 'NR==2 {print $4}' || echo '0G'")

;; ─── Widgets ───────────────────────────────────────────────
(defwidget user-module []
  (label :class "module-user" :text "${poll-user}"))

(defwidget workspaces-module []
  (box :class "module-workspaces" :space-evenly false :spacing 6
    (for ws in poll-workspaces
      (button :class {ws.is_active ? "workspace-btn active" : "workspace-btn"}
              :onclick "hyprctl dispatch workspace ${ws.id}"
              "${ws.id}"))))

(defwidget clock-module []
  (label :class "module-clock" :text "${poll-clock}"))

(defwidget cpu-module []
  (box :class "module-metric metric-cpu" :space-evenly false :spacing 4
    (label :class "icon" :text "")
    (label :class "label" :text "${poll-cpu-usage}% (${poll-cpu-freq})")))

(defwidget ram-module []
  (box :class "module-metric metric-ram" :space-evenly false :spacing 4
    (label :class "icon" :text "")
    (label :class "label" :text "${poll-ram}")))

(defwidget disk-module []
  (box :class "module-metric metric-disk" :space-evenly false :spacing 4
    (label :class "icon" :text "󰋊")
    (label :class "label" :text "${poll-disk} free")))

(defwidget battery-module []
  (box :class "module-metric metric-battery" :space-evenly false :spacing 4
    (label :class "icon" :text "")
    (label :class "label" :text "${poll-battery-cap}%")
    (label :class "icon charging-icon" :text ""
           :visible {poll-battery-stat == "Charging"})))

(defwidget audio-module []
  (box :class "module-metric metric-audio" :space-evenly false :spacing 4
    (label :class "icon" :text {poll-audio-mute == "muted" ? "󰝟 " : " "})
    (label :class "label" :text "${poll-audio-vol}%")))

(defwidget brightness-module []
  (box :class "module-metric metric-brightness" :space-evenly false :spacing 4
    (label :class "icon" :text "")
    (label :class "label" :text "${poll-brightness}%")))

(defwidget tray-module []
  (systray :class "module-tray" :icon-size 20 :spacing 8))

(defwidget separator []
  (label :class "module-separator" :text "│"))

(defwidget nightlight-module []
  (button :class "module-nightlight"
          :onclick "bash ~/.config/eww/nightlight.sh toggle"
    (label :text "${poll-nightlight}")))

;; ─── Main Bar ──────────────────────────────────────────────
(defwidget main-bar []
  (centerbox
    (box :class "bar-left" :halign "start" :space-evenly false :spacing 10
         (nightlight-module) (separator) (user-module) (separator) (workspaces-module))
    (box :halign "center" (separator) (clock-module) (separator))
    (box :class "bar-right" :halign "end" :space-evenly false :spacing 8
         (cpu-module) (separator)
         (ram-module) (separator)
         (disk-module) (separator)
         (audio-module) (separator)
         (brightness-module) (separator)
         (battery-module) (separator)
         (tray-module))))

;; ─── Window ─────────────────────────────────────────────────
(defwindow hyprbar
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "99%" :height "20px" :anchor "bottom center")
  :exclusive true
  :stacking "fg"
  :windowtype "dock"
  (main-bar))
