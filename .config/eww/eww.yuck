;; ─── Variables & Polls ─────────────────────────────────────
(defvar show-date false)
(defpoll poll-time :interval "1s" "date '+%I:%M %p'")
(defpoll poll-date :interval "10s" "date '+%a %b %d, %Y'")
(defpoll poll-workspaces :interval "0.2s" "sh ~/.config/eww/hyprworkspaces.sh")
(defpoll poll-battery-cap :interval "5s" "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo '0'")
(defpoll poll-battery-stat :interval "5s" "cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo 'Unknown'")
(defpoll poll-hyprnight :interval "1s" "sh ~/.config/eww/hyprnight.sh status")

;; Hardware Polls
(defpoll poll-cpu-usage :interval "2s" "top -bn1 | grep 'Cpu(s)' | awk '{print $2}' | cut -d'.' -f1 || echo '0'")
(defpoll poll-cpu-freq :interval "2s" "awk '{sum += $1} END {if (NR > 0) printf \"%.1fGHz\", sum / NR / 1000000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null || echo '0GHz'")
(defpoll poll-ram :interval "3s" "free -h | awk '/Mem:/ {print $3 \"/\" $2}' | tr -d 'i' || echo '0G'")
(defpoll poll-disk :interval "10s" "df -h / | awk 'NR==2 {print $4}' || echo '0G'")
(deflisten poll-net-speed :initial "↓ 0 KB/s ↑ 0 KB/s" "sh ~/.config/eww/netspeed.sh")

;; ─── Widgets ───────────────────────────────────────────────
(defwidget workspaces-module []
  (box :class "module-workspaces" :space-evenly false :spacing 6
    (for ws in poll-workspaces
      (button :class {ws.is_active ? "workspace-btn active" : "workspace-btn"}
              :onclick "hyprctl dispatch workspace ${ws.id}"
              "${ws.id}"))))

(defwidget time-date-module []
  (button :class "module-clock"
          :onclick "eww update show-date=${!show-date}"
    (label :text {show-date ? poll-date : poll-time})))

(defwidget net-module []
  (box :class "module-metric metric-net" :space-evenly false :spacing 4
    (label :class "icon" :text "󰈀")
    (label :class "label" :text "${poll-net-speed}")))

(defwidget cpu-module []
  (box :class "module-metric metric-cpu" :space-evenly false :spacing 4
    (label :class "icon" :text "")
    (label :class "label" :text "${poll-cpu-usage}% (${poll-cpu-freq})")))

(defwidget ram-module []
  (box :class "module-metric metric-ram" :space-evenly false :spacing 4
    (label :class "icon" :text "")
    (label :class "label" :text "${poll-ram}")))

(defwidget disk-module []
  (box :class "module-metric metric-disk" :space-evenly false :spacing 4
    (label :class "icon" :text "󰋊")
    (label :class "label" :text "${poll-disk} free")))

(defwidget battery-module []
  (box :class "module-metric metric-battery" :space-evenly false :spacing 4
    (label :class "icon" :text "")
    (label :class "label" :text "${poll-battery-cap}%")
    (label :class "icon charging-icon" :text ""
           :visible {poll-battery-stat == "Charging"})))

(defwidget tray-module []
  (systray :class "module-tray" :icon-size 20 :spacing 8))

(defwidget separator []
  (label :class "module-separator" :text "│"))

(defwidget hyprnight-module []
  (button :class "module-hyprnight"
          :onclick "bash ~/.config/eww/hyprnight.sh toggle"
    (label :text "${poll-hyprnight}")))

(defwidget main-bar []
  (centerbox
    (box :class "bar-left" :halign "start" :space-evenly false :spacing 2
         (hyprnight-module) (separator) (time-date-module) (separator) (workspaces-module))
    (box :halign "center")
    (box :class "bar-right" :halign "end" :space-evenly false :spacing 6
         (net-module) (separator)
         (cpu-module) (separator)
         (ram-module) (separator)
         (disk-module) (separator)
         (battery-module) (separator)
         (tray-module))))

(defwindow hyprbar
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "99%" :height "20px" :anchor "bottom center")
  :exclusive true
  :stacking "fg"
  :windowtype "dock"
  (main-bar))

;; --- For Capslock and Numlock -------------------------------
(defpoll caps_state :interval "500ms" "cat /sys/class/leds/*capslock/brightness")
(defpoll num_state :interval "500ms" "cat /sys/class/leds/*numlock/brightness")
(defwindow locks
  :monitor 0
  :geometry (geometry :x "1%"
                     :y "10px"
                     :anchor "top right")
  :stacking "overlay"
  (box :orientation "h" :spacing 10
    (label :class "warning-badge"
           :visible {caps_state == "1" ? true : false}
           :text "⚠️ CAPS ON")
    (label :class "warning-badge"
           :visible {num_state == "1" ? true : false}
           :text "⚠️ NUM OFF")))

;; --- For Brightness and Volume ------------------------------
(defvar osd_value 50)
(defvar osd_icon "🔊")
(defwindow vbosd
  :monitor 0
  :geometry (geometry :x "0%"
                     :y "10%"
                     :width "300px"
                     :height "50px"
                     :anchor "bottom center")
  :stacking "overlay"
  (box :class "osd-box" :orientation "h" :space-evenly false :spacing 15
    (label :class "osd-icon" :text osd_icon)
    (scale :class "osd-scale" :value osd_value :min 0 :max 101 :active false)
    (label :class "osd-text" :text "${osd_value}%")))

;; --- Powermenu ---------------------------------------------
(defwindow powermenu
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :anchor "center")
  :stacking "overlay"
  (box :class "powermenu-box" :orientation "h" :spacing 20
    (button :class "pwr-btn" :onclick "eww close powermenu && systemctl poweroff" "⏻")
    (button :class "pwr-btn" :onclick "eww close powermenu && systemctl reboot" "🔄")
    (button :class "pwr-btn" :onclick "eww close powermenu && systemctl suspend" "💤")
    (button :class "pwr-btn" :onclick "eww close powermenu && loginctl terminate-user $USER" "🚪")
    (button :class "pwr-btn cancel" :onclick "eww close powermenu" "❌")))
