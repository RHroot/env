/* Import main config for global settings (modi, icons, font, etc.) */
@import "config.rasi"

* {
    /* Matugen Mappings with Tokyonight-Night Fallbacks */
    background-colour:           var(surface, #1a1b26);
    foreground-colour:           var(on-surface, #cfc9c2);
    border-colour:               var(primary, #7aa2f7);
    handle-colour:               var(primary, #7aa2f7);

    /* Alternate background for input bar fallback */
    alternate-background:        var(surface-container-high, #24283b);

    /* Selection (Brightest) */
    selected-normal-background:  var(primary, #7aa2f7);
    selected-normal-foreground:  var(on-primary, #15161e);

    img-size:                    600px;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       95%;
    enabled:                     true;
    border:                      2px;
    border-radius:               20px;
    border-color:                @border-colour;
    background-color:            @background-colour;
}

mainbox {
    enabled:                     true;
    spacing:                     5px;
    padding:                     10px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px;
    background-color:            transparent;
    border-radius:               10px;
    text-color:                  @foreground-colour;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " ❯";
    background-color:            inherit;
    text-color:                  inherit;
}


entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "search...";
}

listview {
    enabled:                     true;
    columns:                     3;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-columns:               true;
    spacing:                     2px;
    background-color:            transparent;
}

element {
    enabled:                     true;
    padding:                     0px 15px;
    border-radius:               15px;
    orientation:                 vertical;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    cursor:                      pointer;
}

element normal.normal, element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground-colour;
}

element selected.normal {
    background-color:            @selected-normal-background;
    text-color:                  @selected-normal-foreground;
}

element-icon {
    background-color:            transparent;
    size:                        @img-size;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    horizontal-align:            0.5;
    cursor:                      inherit;
}
