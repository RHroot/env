#!/bin/sh
set -euo pipefail

WALL_DIR="$HOME/Wallpapers"
CWD="$(pwd)"

find "$WALL_DIR" -type f \
  \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) \
  | sort \
  | while IFS= read -r file; do
    rel="${file#$WALL_DIR/}"
    label="${rel%.*}"
    printf "%s\0icon\x1f%s\n" "$label" "$file"
  done \
  | fuzzel --dmenu --prompt="Select Wallpaper:> " \
  | while IFS= read -r label; do
    [ -z "$label" ] && exit 0

    FILE=$(find "$WALL_DIR" -type f \
      \( -iname "$label.jpg" \
      -o -iname "$label.jpeg" \
      -o -iname "$label.png" \) \
      | head -n 1)

    [ -n "$FILE" ] && bash "$HOME/env/.local/bin/wset-backend" "$FILE"
  done

cd "$CWD" || exit 1
