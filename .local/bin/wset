#!/bin/sh

Wall_DIR="$HOME/Wallpapers"
CWD="$(pwd)"

cd "$Wall_DIR" || exit

IFS=$'\n'

SELECTED_WALL=$(
  for a in *.jpg *.png *.jpeg; do
    echo "$a"
  done | fuzzel --dmenu --prompt "Select Wallpaper: "
)

if [ -n "$SELECTED_WALL" ]; then
  FULL_PATH="$Wall_DIR/$SELECTED_WALL"
  bash "$HOME/env/.local/bin/wset-backend" "$FULL_PATH"
fi

cd "$CWD" || exit
