#!/bin/sh

COLOR_FILE="$HOME/.cache/Matugen.colors"

# Helper to extract hex colors from the file
get_color() {
  local section="$1"
  local key="$2"
  awk -F= -v sec="$section" -v key="$key" '
        $0 ~ "\\[" sec "\\]" {found=1}
        found && $1 == key {print $2; exit}
    ' "$COLOR_FILE" | tr -d ' \r'
}

# Extract colors for dmenu
BG=$(get_color "WM" "inactiveBackground") # normal background
FG=$(get_color "WM" "inactiveForeground") # normal foreground
SBG=$(get_color "WM" "activeBackground")  # selected background
SFG=$(get_color "WM" "activeForeground")  # selected foreground

# Fallbacks if colors are missing
BG=${BG:-#101418}
FG=${FG:-#c2c7cf}
SBG=${SBG:-#154974}
SFG=${SFG:-#d0e4ff}

# Run dmenu with the colors
dmenu_run -i -l 8 -fn 'JetBrainsMono Nerd Font-20' -nb "$BG" -nf "$FG" -sb "$SBG" -sf "$SFG" -p "Run: "
