#!/bin/sh
set -euo pipefail

STICKER_DIR="$HOME/env/Stickers"

find "$STICKER_DIR" -type f \
  \( -iname "*.png" -o -iname "*.webp" -o -iname "*.jpg" -o -iname "*.gif" \) \
  | sort \
  | while IFS= read -r file; do
    label="${file#$STICKER_DIR/}"
    printf "%s\0icon\x1f%s\n" "$label" "$file"
  done \
  | rofi -dmenu -i -p "Pick ❯" -theme "art_selector" \
  | while IFS= read -r file; do
    [ -z "$file" ] && exit 0

    case "$file" in
      *.png) mime="image/png" ;;
      *.webp) mime="image/webp" ;;
      *.jpg | *.jpeg) mime="image/jpeg" ;;
      *.gif) mime="image/gif" ;;
      *) exit 1 ;;
    esac

    wl-copy --type "$mime" <"$STICKER_DIR/$file"
  done
