#!/bin/sh

set -e

FLAKE=".#rhroot"
LOG_FILE="$HOME/env/nixos-switch.log"

cd ~/env/

HOST_NAME="${FLAKE#*.#}"

# Colors
RED="\033[1;31m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
CYAN="\033[1;36m"
YELLOW="\033[1;33m"
DIM="\033[2m"
BOLD="\033[1m"
RESET="\033[0m"

# Header
echo -e "${BOLD}${BLUE}NixOS Rebuild${RESET}"
echo -e "${DIM}──────────────────────────────${RESET}"
echo -e "${DIM}flake   ${RESET}${FLAKE}"
echo -e "${DIM}target  ${RESET}nixosConfigurations.${HOST_NAME}"
echo -e "${DIM}log     ${RESET}${LOG_FILE}"
echo ""

if sudo nixos-rebuild switch --impure --flake "$FLAKE" --show-trace 2>&1 \
  | tee "$LOG_FILE" \
  | awk '
/building the system configuration/ {
    print "\n\033[1;33m󰐍  Building system\033[0m"; next
}
/activating the configuration/ {
    print "\n\033[1;34m󰑓  Activating configuration\033[0m"; next
}
/restarting|starting|stopping/ {
    print "  \033[1;36m→ " $0 "\033[0m"; next
}
/copying path/ { next }
/substituting/ { next }
/downloading/ {
    print "  \033[2m" $0 "\033[0m"; next
}
/warning/ {
    print "\033[1;33m⚠ " $0 "\033[0m"; next
}
/error/ {
    print "\033[1;31m✖ " $0 "\033[0m"; next
}
'; then

  echo ""
  echo -e "${DIM}──────────────────────────────${RESET}"
  echo -e "${GREEN}✔ Rebuild completed${RESET}"

else
  echo ""
  echo -e "${DIM}──────────────────────────────${RESET}"
  echo -e "${RED}✖ Rebuild failed${RESET}"
  echo ""

  grep -i --color=always "error" "$LOG_FILE" | tail -n 20 || true

  exit 1
fi
