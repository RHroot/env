#!/bin/sh

set -euo pipefail
cd ~/env/
sudo nix flake update
if ! git diff --quiet; then
  git add .
  git commit -m 'changed flake.lock file according to flake.nix'
else
  echo "No changes to commit, skipping git commit"
fi
echo "Rebuilding NixOS configuration..."
sudo nixos-rebuild switch --impure --upgrade --flake '.#rhroot-nix' --show-trace &>nixos-switch.log || (cat nixos-switch.log | grep --color error && false)
echo "NixOS configuration rebuilt successfully."
nix store optimise
