#!/bin/sh

set -euo pipefail

cd ~/env/

FLAKE=".#rhroot"
LOG_FILE="$HOME/env/nixos-switch.log"
HOST_NAME="${FLAKE#*.#}"

# Colors
RED="\033[1;31m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
MAGENTA="\033[1;35m"
CYAN="\033[1;36m"
YELLOW="\033[1;33m"
DIM="\033[2m"
BOLD="\033[1m"
RESET="\033[0m"

# Header (upgrade-focused)
echo -e "${BOLD}${MAGENTA}NixOS Upgrade${RESET}"
echo -e "${DIM}──────────────────────────────${RESET}"
echo -e "${DIM}flake   ${RESET}${FLAKE}"
echo -e "${DIM}target  ${RESET}nixosConfigurations.${HOST_NAME}"
echo -e "${DIM}log     ${RESET}${LOG_FILE}"
echo ""

# --- Update flake ---
echo -e "${YELLOW}󰚰 Updating flake inputs${RESET}"
sudo nix flake update

# --- Git commit (if needed) ---
echo -e "${YELLOW}󰊢 Syncing lockfile${RESET}"
if ! git diff --quiet; then
  git add .
  git commit -m 'changed flake.lock file according to flake.nix'
  echo -e "  ${CYAN}→ committed changes${RESET}"
else
  echo -e "  ${DIM}→ no changes${RESET}"
fi

# --- Rebuild ---
echo ""
echo -e "${YELLOW}󰐍 Rebuilding system${RESET}"

if sudo nixos-rebuild switch --impure --upgrade --flake "$FLAKE" --show-trace \
  >"$LOG_FILE" 2>&1; then

  echo -e "${GREEN}  ✔ rebuild successful${RESET}"

else
  echo -e "${RED}  ✖ rebuild failed${RESET}"
  echo ""

  grep -i --color=always "error" "$LOG_FILE" | tail -n 20 || true
  exit 1
fi

# --- Optimize store ---
echo ""
echo -e "${YELLOW}󰆼 Optimizing store${RESET}"
nix store optimise >/dev/null 2>&1 \
  && echo -e "${GREEN}  ✔ optimization complete${RESET}"

echo ""
echo -e "${DIM}──────────────────────────────${RESET}"
echo -e "${GREEN}Upgrade complete${RESET}"
