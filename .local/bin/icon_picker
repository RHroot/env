#!/bin/sh

ICON_FILE="$HOME/.config/rofi/data/icons.csv"

if [ ! -f "$ICON_FILE" ]; then
  echo "Icon file not found!"
  exit 1
fi

SELECTED=$(cat "$ICON_FILE" | rofi -dmenu -i -p "Search Icons" -theme config)

if [ -n "$SELECTED" ]; then
  # Extract just the first character (the icon) and copy to clipboard
  ICON=$(echo "$SELECTED" | awk '{print $1}')
  echo -n "$ICON" | wl-copy

  # Optional: Send a small notification
  # notify-send "Icon Copied" "'$ICON' is ready to paste." -i "edit-copy"
fi
